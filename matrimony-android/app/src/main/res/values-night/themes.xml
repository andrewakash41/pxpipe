<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vachan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Vachan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_night</item>
        <item name="postSplashScreenTheme">@style/Theme.Vachan</item>
    </style>
</resources>
